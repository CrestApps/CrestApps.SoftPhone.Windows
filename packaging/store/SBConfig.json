{
    // StoreBroker submission config for CrestApps Soft Phone.
    //
    // Consumed by scripts/Submit-Store.ps1 -> New-SubmissionPackage. The paths that change
    // per run (the built package, the PDP root, and the output folder) are passed explicitly
    // by Submit-Store.ps1, so this file only carries the stable submission-shaping settings.
    //
    // This is a hand-maintained starting point. To regenerate an authoritative baseline from
    // the live listing at any time:
    //     Install-Module StoreBroker -Scope CurrentUser
    //     New-StoreBrokerConfigFile -AppId <STORE_APP_ID> -Path .\SBConfig.json
    // then re-apply the comments/paths below.

    // Optional — Submit-Store.ps1 passes -AppId from the STORE_APP_ID secret, so leaving this
    // blank is fine. Fill it in only if you run New-SubmissionPackage by hand.
    "appId": "",

    // Which PDP files to pull in (relative to the -PDPRootPath Submit-Store.ps1 supplies:
    // packaging/store/PDP). One ProductDescription.xml per language folder.
    "PDPInclude": [ "ProductDescription.xml" ],
    "PDPExclude": [],

    // Screenshots/media referenced by each PDP live alongside it under PDP/<lang>/. This
    // points New-SubmissionPackage at that same tree.
    "MediaRootPath": "PDP",
    "MediaFallbackLanguage": "en-us",

    // Don't submit a language just because a folder exists; en-us is the source of truth and
    // fills in for any locale without its own PDP.
    "LanguageExclude": [ "default" ],

    // Left empty on purpose — Submit-Store.ps1 supplies -AppxPath (the freshly built
    // .msixupload), -OutPath, and -OutName at submit time.
    "AppxPath": [],
    "OutPath": "",
    "OutName": ""
}
