# Normalize line endings
* text=auto eol=lf

# Windows-specific and script files keep CRLF
*.sln        text eol=crlf
*.csproj     text eol=crlf
*.props      text eol=crlf
*.targets    text eol=crlf
*.cs         text eol=crlf
*.xaml       text eol=crlf
*.admx       text eol=crlf
*.adml       text eol=crlf
*.ps1        text eol=crlf
*.cmd        text eol=crlf
*.bat        text eol=crlf

# Binary assets
*.ico   binary
*.png   binary
*.wav   binary
*.pfx   binary
*.snk   binary
