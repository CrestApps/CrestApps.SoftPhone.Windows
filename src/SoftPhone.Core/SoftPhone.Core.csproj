<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI-free logic: the integration contract, config/hub clients, settings, policy,
    and the Phase 0 diagnostics. Everything here is unit-testable without a desktop
    session (SoftPhone.Core.Tests). The only Windows-specific piece is the WebView2
    cookie bridge, which is kept behind a small surface so tests never instantiate it.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- RIDs so the MSIX packaging project can publish this referenced project per-arch
         without NETSDK1047. RID-less builds/tests are unaffected. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

</Project>
