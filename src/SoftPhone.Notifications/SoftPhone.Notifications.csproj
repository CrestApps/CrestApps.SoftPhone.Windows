<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI-free notification logic: builds the toast payload/arguments and parses the
    activation arguments back. Deliberately pure (no Windows App SDK reference) so the
    important logic is unit-tested without a desktop session — the app project consumes
    the built XML and hands it to the OS notification API, and passes activation args
    back through the parser here.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- RIDs so the MSIX packaging project can publish this referenced project per-arch
         without NETSDK1047. RID-less builds/tests are unaffected. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
