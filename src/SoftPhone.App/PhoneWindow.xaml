<Window x:Class="SoftPhone.App.PhoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CrestApps Soft Phone" Height="760" Width="420"
        MinHeight="480" MinWidth="360"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title bar (window chrome): identity + status on the left, settings +
                 caption buttons on the right. Replaces the old in-content status bar. -->
            <Grid Grid.Row="0" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Source="pack://application:,,,/Assets/app-32.png" Width="16" Height="16" />
                    <TextBlock Text="Soft Phone" Foreground="{StaticResource Ink}" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="SettingsButton" Style="{StaticResource CaptionButton}" Content="&#xE713;"
                            ToolTip="Settings" Click="SettingsButton_Click" />
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            ToolTip="Minimize" Click="MinButton_Click" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            ToolTip="Maximize" Click="MaxButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"
                            ToolTip="Close" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Content: the /softphone page (full area) or the first-run setup prompt. -->
            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="Web" Visibility="Collapsed" />

                <Border x:Name="SetupView" Background="White" Visibility="Collapsed">
                    <Border MaxWidth="360" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="8">
                        <StackPanel>
                            <Image Source="pack://application:,,,/Assets/app-256.png" Width="72" Height="72"
                                   HorizontalAlignment="Center" />
                            <TextBlock Text="Connect your soft phone" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}"
                                       Margin="0,6,0,0"
                                       Text="Enter your organization's soft phone domain to get started. You'll sign in with your normal site login." />

                            <TextBlock Text="Tenant domain" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,20,0,4" />
                            <TextBox x:Name="SetupDomainBox" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                     KeyDown="SetupDomainBox_KeyDown" />
                            <TextBlock Text="e.g. dialpad-dev.crestapps.online" Foreground="{StaticResource Muted}"
                                       FontSize="12" Margin="2,4,0,0" />

                            <Border x:Name="SetupMessage" Visibility="Collapsed" Margin="0,12,0,0" Padding="10,7" CornerRadius="6">
                                <TextBlock x:Name="SetupMessageText" TextWrapping="Wrap" Foreground="White" />
                            </Border>

                            <Button x:Name="ContinueButton" Content="Continue" Height="38" Margin="0,16,0,0"
                                    Background="{StaticResource Brand}" Foreground="White" BorderThickness="0"
                                    FontSize="14" FontWeight="SemiBold" Cursor="Hand" Click="ContinueButton_Click" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
