<Window x:Class="SoftPhone.App.IncomingCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incoming call" Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <!-- Compact buttons for a matched record's actions. -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,6,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        </Style>
        <Style x:Key="CardAnswerButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Background" Value="#16A34A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="10" Margin="10" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.28" Color="#334155" />
        </Border.Effect>
        <StackPanel Margin="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{StaticResource Brand}">
                    <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                               FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CallerName" Text="Incoming call" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CallerNumber" Text="" Foreground="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
                <Border Grid.Column="2" x:Name="QueueBadge" Visibility="Collapsed" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                        Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock x:Name="QueueText" FontSize="11" Foreground="{StaticResource Muted}" />
                </Border>
            </Grid>

            <!-- Matched records (e.g. customers the caller's number matched), built in code-behind. -->
            <StackPanel x:Name="CardsSection" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock x:Name="CardsHeading" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CardsPanel" />
                </ScrollViewer>
                <TextBlock x:Name="MoreCards" Visibility="Collapsed" Margin="0,6,0,0" FontSize="12"
                           Foreground="{StaticResource Muted}" />
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="VoicemailGap" Width="8" />
                    <ColumnDefinition x:Name="VoicemailColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="AnswerButton" Content="Answer" Height="38" Cursor="Hand"
                        Background="#16A34A" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                        Click="Answer_Click" />
                <Button Grid.Column="2" x:Name="DeclineButton" Content="Decline" Height="38" Cursor="Hand"
                        Background="#DC2626" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                        Click="Decline_Click" />
                <Button Grid.Column="4" x:Name="VoicemailButton" Content="Voicemail" Height="38" Cursor="Hand"
                        Background="{StaticResource Panel}" Foreground="{StaticResource Ink}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" Click="Voicemail_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
