Windows Registry Editor Version 5.00

; Managed configuration for Soft Phone (read by the app's PolicyProvider).
; Pre-fills and LOCKS the tenant domain so pilot users never type it.
; Deploy via Intune (Devices > Configuration > registry / OMA-URI) or Group Policy.
;
; >>> Replace phone.example.com with your real production tenant domain. <<<
; For the dev pilot you can use: dialpad-dev.crestapps.online

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\CrestApps\SoftPhone]
"Domain"="phone.example.com"
"AllowUserOverrideDomain"=dword:00000000
"StartWithWindows"=dword:00000001
"RingtoneEnabled"=dword:00000001
